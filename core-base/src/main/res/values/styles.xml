<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base Material3 Theme -->
    <style name="AppBaseTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/themeColor</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/themeColor</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/themeColor</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/themeColor</item>
        <item name="colorOnSecondaryContainer">@color/white</item>
        <!-- Tertiary brand color -->
        <item name="colorTertiary">@color/themeColor</item>
        <item name="colorOnTertiary">@color/white</item>
        <item name="colorTertiaryContainer">@color/themeColor</item>
        <item name="colorOnTertiaryContainer">@color/white</item>
        <!-- Error color -->
        <item name="colorError">@color/theme_red</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorErrorContainer">@color/theme_red</item>
        <item name="colorOnErrorContainer">@color/white</item>
        <!-- Surface colors (Material3) -->
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/autoColor</item>
        <item name="colorSurfaceVariant">@color/surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/onSurfaceVariant</item>
        <!-- Background -->
        <item name="android:colorBackground">@color/default_background</item>
        <item name="colorOnBackground">@color/autoColor</item>
        <!-- Outline -->
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outlineVariant</item>
        <!-- Inverse -->
        <item name="colorSurfaceInverse">@color/surfaceInverse</item>
        <item name="colorOnSurfaceInverse">@color/onSurfaceInverse</item>
        <item name="colorPrimaryInverse">@color/primaryInverse</item>
        <!-- Status bar -->
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:navigationBarColor">@color/white</item>
        <!-- PopupMenu style -->
        <item name="android:popupMenuStyle">@style/OverflowMenuStyle</item>
        <!-- Material3 Component styles - 使用不覆盖背景的样式 -->
        <item name="materialButtonStyle">@style/Widget.Material3.Button.TextButton</item>
        <item name="materialCardViewStyle">@style/Widget.Material3.CardView.Filled</item>
        <item name="textInputStyle">@style/Widget.Material3.TextInputLayout.OutlinedBox</item>
        <item name="bottomNavigationStyle">@style/Widget.Material3.BottomNavigationView</item>
        <item name="tabStyle">@style/customTabLayout</item>
    </style>

    <!-- 自定义loading dialog - 使用Material3风格，内容自适应 -->
    <!--
        修复说明：原 parent=ThemeOverlay.Material3.MaterialAlertDialog 会强制设置
        android:windowMinWidthMajor / windowMinWidthMinor / windowFixedWidthMajor /
        windowFixedWidthMinor，导致 Dialog 宽度被硬性约束，无法随内容自适应。
        这里改用 @android:style/Theme.Translucent.NoTitleBar 作为基底，并显式将上述
        四个窗口宽度属性归零，确保宽度由 wrap_content 的内容布局决定。
    -->
    <style name="loading_dialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <!-- TabLayout布局样式 -->
    <style name="customTabLayout" parent="Widget.Material3.TabLayout">
        <item name="tabIndicatorColor">@color/themeColor</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/height_xxl</item>
        <item name="tabSelectedTextColor">@color/themeColor</item>
        <item name="android:background">@color/white</item>
        <item name="android:textSize">@dimen/font_size_xl</item>
        <item name="android:textColor">@color/autoColor</item>
    </style>

    <!-- 弹框dialog - 使用Material3 -->
    <style name="ActionSheetDialogStyle" parent="Theme.Material3.DayNight.Dialog">
        <!-- 背景透明 -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <!-- 浮于Activity之上 -->
        <item name="android:windowIsFloating">true</item>
        <!-- 边框 -->
        <item name="android:windowFrame">@null</item>
        <!-- Dialog以外的区域模糊效果 -->
        <item name="android:backgroundDimEnabled">true</item>
        <!-- 无标题 -->
        <item name="android:windowNoTitle">true</item>
        <!-- 半透明 -->
        <item name="android:windowIsTranslucent">true</item>
        <!-- Dialog进入及退出动画 -->
        <item name="android:windowAnimationStyle">@style/ActionSheetDialogAnimation</item>
    </style>

    <!-- 专门给 ConfirmDialog 用的样式，控制按压高亮色 -->
    <style name="DialogSoftHighlightStyle" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:colorControlHighlight">#33CCCCCC</item>
        <item name="colorControlHighlight">#33CCCCCC</item>
    </style>

    <!-- ActionSheet进出动画 -->
    <style name="ActionSheetDialogAnimation" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/actionsheet_dialog_in</item>
        <item name="android:windowExitAnimation">@anim/actionsheet_dialog_out</item>
    </style>

    <!-- 朋友圈图片全屏样式 -->
    <style name="PreviewPhotoDialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">1</item>
        <item name="android:windowAnimationStyle">@style/ShowImageDialogAnimation</item>
    </style>

    <style name="ShowImageDialogAnimation" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/scale_in</item>
        <item name="android:windowExitAnimation">@anim/scale_out</item>
    </style>

    <style name="dialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="ToolBarStyle_black" parent="ThemeOverlay.MaterialComponents.Toolbar.Primary">
        <item name="android:textSize">@dimen/font_size_xl</item>
        <item name="android:textStyle">normal</item>
        <item name="colorControlNormal">@color/black</item>
        <item name="overlapAnchor">false</item>
    </style>

    <style name="OverflowMenuStyle" parent="Widget.Material3.PopupMenu.Overflow">
        <item name="overlapAnchor">false</item>
        <item name="android:dropDownWidth">wrap_content</item>
        <item name="android:background">@android:color/white</item>
        <item name="android:dropDownVerticalOffset">5dp</item>
        <item name="android:dropDownHorizontalOffset">0dp</item>
        <item name="android:textColor">@color/autoColor</item>
    </style>

    <style name="ToolBarStyle_white" parent="ThemeOverlay.MaterialComponents.Toolbar.Primary">
        <item name="android:textSize">@dimen/font_size_xl</item>
        <item name="android:textStyle">normal</item>
        <item name="colorControlNormal">@color/white</item>
        <item name="overlapAnchor">false</item>
    </style>

    <!-- 弹框dialog -->
    <style name="ActionSheetDialogStyle_No_Bg" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowAnimationStyle">@style/ActionSheetDialogAnimation</item>
    </style>

    <style name="like_toast_dialog_style" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
