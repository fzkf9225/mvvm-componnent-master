<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base Material3 Theme -->
    <style name="AppBaseTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/themeColor</item>
        <item name="colorOnPrimary">@color/buttonPrimaryText</item>
        <item name="colorPrimaryContainer">@color/themeColor</item>
        <item name="colorOnPrimaryContainer">@color/buttonPrimaryText</item>
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/themeColor</item>
        <item name="colorOnSecondary">@color/buttonPrimaryText</item>
        <item name="colorSecondaryContainer">@color/themeColor</item>
        <item name="colorOnSecondaryContainer">@color/buttonPrimaryText</item>
        <!-- Tertiary brand color -->
        <item name="colorTertiary">@color/themeColor</item>
        <item name="colorOnTertiary">@color/buttonPrimaryText</item>
        <item name="colorTertiaryContainer">@color/themeColor</item>
        <item name="colorOnTertiaryContainer">@color/buttonPrimaryText</item>
        <!-- Error color -->
        <item name="colorError">@color/theme_red</item>
        <item name="colorOnError">@color/buttonPrimaryText</item>
        <item name="colorErrorContainer">@color/theme_red</item>
        <item name="colorOnErrorContainer">@color/buttonPrimaryText</item>
        <!-- Surface colors (Material3) - 使用语义颜色 -->
        <item name="colorSurface">@color/cardSurface</item>
        <item name="colorOnSurface">@color/cardOnSurface</item>
        <item name="colorSurfaceVariant">@color/cardSurfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/cardOnSurfaceVariant</item>
        <!-- Background -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/autoColor</item>
        <!-- Outline -->
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outlineVariant</item>
        <!-- Inverse -->
        <item name="colorSurfaceInverse">@color/surfaceInverse</item>
        <item name="colorOnSurfaceInverse">@color/onSurfaceInverse</item>
        <item name="colorPrimaryInverse">@color/primaryInverse</item>
        <!-- Navigation bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/cardSurface</item>
        <item name="android:windowLightStatusBar">@bool/window_light_status_bar</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/window_light_navigation_bar</item>
        <!-- PopupMenu style -->
        <item name="android:popupMenuStyle">@style/OverflowMenuStyle</item>
        <!-- Material3 Component styles -->
        <item name="materialCardViewStyle">@style/Widget.Material3.CardView.Filled</item>
        <item name="textInputStyle">@style/Widget.Material3.TextInputLayout.OutlinedBox</item>
        <item name="bottomNavigationStyle">@style/Widget.Material3.BottomNavigationView</item>
        <item name="tabStyle">@style/customTabLayout</item>
        <!-- MaterialButton 去掉默认 6dp 上下 inset，layout_height 才是实际可视高度 -->
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.App.Button.OutlinedButton</item>
        <item name="borderlessButtonStyle">@style/Widget.App.Button.TextButton</item>
        <item name="materialIconButtonStyle">@style/Widget.App.Button.IconButton</item>
    </style>

    <!--
        Material3 Button 默认 insetTop/Bottom=6dp，指定高度时背景会被裁掉一圈。
        布局不要再写 android:insetTop/Bottom=0dp，用本样式或主题默认即可。
    -->
    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.App.Button.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.App.Button.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.App.Button.IconButton" parent="Widget.Material3.Button.IconButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Dialog 共用语义色，避免 Theme.Material3.Dialog 不继承 AppBaseTheme 导致暗色仍是浅色表面 -->
    <style name="App.Material3.Dialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="colorPrimary">@color/themeColor</item>
        <item name="colorOnPrimary">@color/buttonPrimaryText</item>
        <item name="colorSurface">@color/cardSurface</item>
        <item name="colorOnSurface">@color/cardOnSurface</item>
        <item name="colorSurfaceVariant">@color/cardSurfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/cardOnSurfaceVariant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outlineVariant</item>
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.App.Button.OutlinedButton</item>
        <item name="borderlessButtonStyle">@style/Widget.App.Button.TextButton</item>
        <item name="materialIconButtonStyle">@style/Widget.App.Button.IconButton</item>
    </style>

    <!-- 自定义loading dialog - 使用Material3风格，内容自适应 -->
    <style name="loading_dialog" parent="App.Material3.Dialog">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <!-- TabLayout布局样式 - 使用语义颜色 -->
    <style name="customTabLayout" parent="Widget.Material3.TabLayout">
        <item name="tabIndicatorColor">@color/themeColor</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/height_xxl</item>
        <item name="tabSelectedTextColor">@color/themeColor</item>
        <item name="android:background">?attr/colorSurface</item>
        <item name="android:textSize">@dimen/font_size_xl</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- 弹框dialog - 使用Material3 -->
    <style name="ActionSheetDialogStyle" parent="App.Material3.Dialog">
        <!-- 背景透明 -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <!-- 浮于Activity之上 -->
        <item name="android:windowIsFloating">true</item>
        <!-- 边框 -->
        <item name="android:windowFrame">@null</item>
        <!-- Dialog以外的区域模糊效果 -->
        <item name="android:backgroundDimEnabled">true</item>
        <!-- 无标题 -->
        <item name="android:windowNoTitle">true</item>
        <!-- 半透明 -->
        <item name="android:windowIsTranslucent">true</item>
        <!-- Dialog进入及退出动画 -->
        <item name="android:windowAnimationStyle">@style/ActionSheetDialogAnimation</item>
    </style>

    <!-- 专门给 ConfirmDialog 用的样式，控制按压高亮色 -->
    <style name="DialogSoftHighlightStyle" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:colorControlHighlight">?attr/colorPrimary</item>
        <item name="colorControlHighlight">?attr/colorPrimary</item>
    </style>

    <!-- ActionSheet进出动画 -->
    <style name="ActionSheetDialogAnimation" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/actionsheet_dialog_in</item>
        <item name="android:windowExitAnimation">@anim/actionsheet_dialog_out</item>
    </style>

    <!-- 朋友圈图片全屏样式 -->
    <style name="PreviewPhotoDialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">1</item>
        <item name="android:windowAnimationStyle">@style/ShowImageDialogAnimation</item>
    </style>

    <style name="ShowImageDialogAnimation" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/scale_in</item>
        <item name="android:windowExitAnimation">@anim/scale_out</item>
    </style>

    <style name="dialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Toolbar 样式 - 使用 Material3 -->
    <style name="ToolBarStyle_black" parent="Widget.Material3.Toolbar">
        <item name="android:textSize">@dimen/font_size_xl</item>
        <item name="android:textStyle">normal</item>
        <item name="colorControlNormal">?attr/colorOnSurface</item>
        <item name="overlapAnchor">false</item>
    </style>

    <!-- OverflowMenu 样式 - 使用语义颜色 -->
    <style name="OverflowMenuStyle" parent="Widget.Material3.PopupMenu.Overflow">
        <item name="overlapAnchor">false</item>
        <item name="android:dropDownWidth">wrap_content</item>
        <item name="android:background">?attr/colorSurface</item>
        <item name="android:dropDownVerticalOffset">5dp</item>
        <item name="android:dropDownHorizontalOffset">0dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Toolbar 白色图标样式 - 使用 Material3 -->
    <style name="ToolBarStyle_white" parent="Widget.Material3.Toolbar">
        <item name="android:textSize">@dimen/font_size_xl</item>
        <item name="android:textStyle">normal</item>
        <item name="colorControlNormal">@color/buttonPrimaryText</item>
        <item name="overlapAnchor">false</item>
    </style>

    <!-- 弹框dialog 无背景 -->
    <style name="ActionSheetDialogStyle_No_Bg" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowAnimationStyle">@style/ActionSheetDialogAnimation</item>
    </style>

    <style name="like_toast_dialog_style" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
