<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        全局 Material3 主题。
        colorPrimary / colorOnPrimary：主色填充 vs 铺在主色上的字。
        colorSurface / colorOnSurface：卡片表面 vs 表面上的正文。
        colorOnSurfaceVariant：hint、次要字。
        colorOutline：描边；colorOutlineVariant：分割线。
        colorError：校验/必填，不要拿 theme_red 硬编码。
        控件默认样式（Button / TIL / Card）从这里往下继承。
    -->
    <style name="AppBaseTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/themeColor</item>
        <item name="colorOnPrimary">@color/onPrimary</item>
        <item name="colorPrimaryContainer">@color/primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/onPrimaryContainer</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/onSecondary</item>
        <item name="colorSecondaryContainer">@color/secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/onSecondaryContainer</item>
        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorOnTertiary">@color/onTertiary</item>
        <item name="colorTertiaryContainer">@color/tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/onTertiaryContainer</item>
        <item name="colorError">@color/theme_red</item>
        <item name="colorOnError">@color/onError</item>
        <item name="colorErrorContainer">@color/errorContainer</item>
        <item name="colorOnErrorContainer">@color/onErrorContainer</item>
        <item name="colorSurface">@color/cardSurface</item>
        <item name="colorOnSurface">@color/cardOnSurface</item>
        <item name="colorSurfaceVariant">@color/cardSurfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/cardOnSurfaceVariant</item>
        <item name="colorSurfaceDim">@color/surfaceDim</item>
        <item name="colorSurfaceBright">@color/surfaceBright</item>
        <item name="colorSurfaceContainerLowest">@color/surfaceContainerLowest</item>
        <item name="colorSurfaceContainerLow">@color/surfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/surfaceContainerHighest</item>
        <item name="android:colorBackground">@color/default_background</item>
        <item name="colorOnBackground">@color/cardOnSurface</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outlineVariant</item>
        <item name="colorSurfaceInverse">@color/surfaceInverse</item>
        <item name="colorOnSurfaceInverse">@color/onSurfaceInverse</item>
        <item name="colorPrimaryInverse">@color/primaryInverse</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/surfaceContainer</item>
        <item name="android:windowLightStatusBar">@bool/window_light_status_bar</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/window_light_navigation_bar</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="android:popupMenuStyle">@style/OverflowMenuStyle</item>
        <item name="toolbarStyle">@style/Widget.App.Toolbar</item>
        <item name="materialCardViewStyle">@style/Widget.Material3.CardView.Filled</item>
        <item name="textInputStyle">@style/Widget.Material3.TextInputLayout.OutlinedBox</item>
        <item name="bottomNavigationStyle">@style/Widget.Material3.BottomNavigationView</item>
        <item name="tabStyle">@style/customTabLayout</item>
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.App.Button.OutlinedButton</item>
        <item name="borderlessButtonStyle">@style/Widget.App.Button.TextButton</item>
        <item name="materialIconButtonStyle">@style/Widget.App.Button.IconButton</item>
        <item name="materialCalendarTheme">@style/ThemeOverlay.App.MaterialCalendar</item>
        <item name="materialCalendarFullscreenTheme">@style/ThemeOverlay.Material3.MaterialCalendar.Fullscreen</item>
        <item name="materialTimePickerTheme">@style/ThemeOverlay.App.MaterialTimePicker</item>
    </style>

    <!-- MaterialDatePicker：标题走 onSurface；格子尺寸跟系统 density，避免 AutoSize 把周日列裁掉 -->
    <style name="ThemeOverlay.App.MaterialCalendar" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="colorPrimary">@color/themeColor</item>
        <item name="colorOnPrimary">@color/onPrimary</item>
        <item name="colorSurface">@color/cardSurface</item>
        <item name="colorOnSurface">@color/cardOnSurface</item>
        <item name="colorOnSurfaceVariant">@color/cardOnSurfaceVariant</item>
        <item name="colorSurfaceContainerHigh">@color/surfaceContainerHigh</item>
        <item name="materialCalendarHeaderTitle">@style/Widget.App.MaterialCalendar.HeaderTitle</item>
        <item name="materialCalendarHeaderSelection">@style/Widget.App.MaterialCalendar.HeaderSelection</item>
        <item name="materialCalendarStyle">@style/Widget.App.MaterialCalendar</item>
    </style>
    <style name="ThemeOverlay.App.MaterialTimePicker" parent="ThemeOverlay.Material3.MaterialTimePicker">
        <item name="colorPrimary">@color/themeColor</item>
        <item name="colorOnPrimary">@color/onPrimary</item>
        <item name="colorSurface">@color/cardSurface</item>
        <item name="colorOnSurface">@color/cardOnSurface</item>
        <item name="colorOnSurfaceVariant">@color/cardOnSurfaceVariant</item>
    </style>
    <style name="Widget.App.MaterialCalendar.HeaderTitle" parent="Widget.Material3.MaterialCalendar.HeaderTitle">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="Widget.App.MaterialCalendar.HeaderSelection" parent="Widget.Material3.MaterialCalendar.HeaderSelection">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="Widget.App.MaterialCalendar" parent="Widget.Material3.MaterialCalendar">
        <item name="dayStyle">@style/Widget.App.MaterialCalendar.Day</item>
        <item name="daySelectedStyle">@style/Widget.App.MaterialCalendar.Day.Selected</item>
        <item name="dayTodayStyle">@style/Widget.App.MaterialCalendar.Day.Today</item>
        <item name="dayInvalidStyle">@style/Widget.App.MaterialCalendar.Day.Invalid</item>
    </style>
    <style name="Widget.App.MaterialCalendar.Day" parent="Widget.Material3.MaterialCalendar.Day">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
    </style>
    <style name="Widget.App.MaterialCalendar.Day.Selected" parent="Widget.Material3.MaterialCalendar.Day.Selected">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
    </style>
    <style name="Widget.App.MaterialCalendar.Day.Today" parent="Widget.Material3.MaterialCalendar.Day.Today">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
    </style>
    <style name="Widget.App.MaterialCalendar.Day.Invalid" parent="Widget.Material3.MaterialCalendar.Day.Invalid">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
    </style>

    <!-- 主题默认按钮：去掉 M3 inset，layout_height 就是可视高度 -->
    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.App.Button.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.App.Button.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.App.Button.IconButton" parent="Widget.Material3.Button.IconButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
    </style>

    <!-- 铺满 layout_height：去掉 M3 默认 inset，圆角/填充走 XML 官方属性 -->
    <style name="Widget.App.Button.Flush" parent="Widget.Material3.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="elevation">0dp</item>
    </style>
    <style name="Widget.App.Button.Flush.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="elevation">0dp</item>
    </style>
    <style name="Widget.App.Button.Flush.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.App.Card.Flush" parent="Widget.Material3.CardView.Filled">
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- 独立输入框（搜索、弹窗）。Form 行内输入不要用这个，会多出描边和内边距。 -->
    <style name="Widget.App.TextInputLayout.Dense" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.TextInputEditText.Dense</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_l</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_l</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_l</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_l</item>
        <item name="boxBackgroundColor">?attr/colorSurface</item>
        <item name="hintEnabled">false</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1dp</item>
        <item name="endIconMinSize">24dp</item>
    </style>
    <style name="ThemeOverlay.App.TextInputEditText.Dense" parent="">
        <item name="editTextStyle">@style/Widget.App.TextInputEditText.Dense</item>
    </style>
    <style name="Widget.App.TextInputEditText.Dense" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:minHeight">@dimen/height_xl</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingStart">@dimen/padding_l</item>
        <item name="android:paddingEnd">@dimen/padding_l</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <!-- Form 行内输入：无描边、无 hint 上浮，避免改变左 Label 右值排版。error/helper/counter 仍可用。 -->
    <style name="Widget.App.TextInputLayout.FormRow" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundMode">none</item>
        <item name="hintEnabled">false</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="errorEnabled">false</item>
        <item name="helperTextEnabled">false</item>
    </style>

    <!-- Form 行内 ExposedDropdown：无描边，minHeight 与性别 FormSelection 对齐 -->
    <style name="ThemeOverlay.App.FormDropdown" parent="">
        <item name="textInputStyle">@style/Widget.App.TextInputLayout.FormDropdown</item>
        <item name="autoCompleteTextViewStyle">@style/Widget.App.AutoComplete.FormDropdown</item>
    </style>
    <style name="Widget.App.TextInputLayout.FormDropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="hintEnabled">false</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="endIconMinSize">20dp</item>
        <item name="boxBackgroundColor">@android:color/transparent</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.AutoComplete.FormDropdown</item>
    </style>
    <style name="ThemeOverlay.App.AutoComplete.FormDropdown" parent="">
        <item name="autoCompleteTextViewStyle">@style/Widget.App.AutoComplete.FormDropdown</item>
    </style>
    <style name="Widget.App.AutoComplete.FormDropdown" parent="Widget.Material3.AutoCompleteTextView.OutlinedBox">
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:background">@null</item>
    </style>

    <style name="TextAppearance.App.Toolbar.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.App.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.App.Toolbar.Title</item>
        <item name="titleCentered">true</item>
        <item name="subtitleCentered">true</item>
        <item name="navigationIconTint">?attr/colorOnSurface</item>
    </style>

    <!-- 品牌色 Toolbar（搜索页等）：标题/图标走 onPrimary -->
    <style name="Widget.App.Toolbar.OnPrimary" parent="Widget.App.Toolbar">
        <item name="navigationIconTint">?attr/colorOnPrimary</item>
        <item name="titleTextColor">?attr/colorOnPrimary</item>
        <item name="colorControlNormal">?attr/colorOnPrimary</item>
    </style>

    <style name="App.Material3.Dialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="colorPrimary">@color/themeColor</item>
        <item name="colorOnPrimary">@color/onPrimary</item>
        <item name="colorPrimaryContainer">@color/primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/onPrimaryContainer</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/onSecondary</item>
        <item name="colorSurface">@color/cardSurface</item>
        <item name="colorOnSurface">@color/cardOnSurface</item>
        <item name="colorSurfaceVariant">@color/cardSurfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/cardOnSurfaceVariant</item>
        <item name="colorSurfaceContainer">@color/surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/surfaceContainerHighest</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outlineVariant</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="materialButtonStyle">@style/Widget.Material3.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Material3.Button.OutlinedButton</item>
        <item name="borderlessButtonStyle">@style/Widget.Material3.Button.TextButton</item>
        <item name="materialIconButtonStyle">@style/Widget.Material3.Button.IconButton</item>
    </style>

    <style name="loading_dialog_base" parent="App.Material3.Dialog">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <style name="loading_dialog" parent="loading_dialog_base">
        <!-- 亮色：黑底面板上的转圈与文字用白色 -->
        <item name="loadingDialogContentColor">#FFFFFFFF</item>
    </style>

    <style name="customTabLayout" parent="Widget.Material3.TabLayout">
        <item name="tabIndicatorColor">?attr/colorPrimary</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/height_xxl</item>
        <item name="tabSelectedTextColor">?attr/colorPrimary</item>
        <item name="android:background">?attr/colorSurface</item>
        <item name="android:textSize">@dimen/font_size_xl</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="ActionSheetDialogStyle" parent="App.Material3.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@style/ActionSheetDialogAnimation</item>
    </style>

    <style name="ActionSheetDialogAnimation" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/actionsheet_dialog_in</item>
        <item name="android:windowExitAnimation">@anim/actionsheet_dialog_out</item>
    </style>

    <style name="PreviewPhotoDialog" parent="App.Material3.Dialog">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">1</item>
        <item name="android:windowAnimationStyle">@style/ShowImageDialogAnimation</item>
    </style>

    <style name="ShowImageDialogAnimation" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/scale_in</item>
        <item name="android:windowExitAnimation">@anim/scale_out</item>
    </style>

    <style name="dialog" parent="App.Material3.Dialog">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="ToolBarStyle_black" parent="Widget.App.Toolbar" />

    <style name="OverflowMenuStyle" parent="Widget.Material3.PopupMenu.Overflow">
        <item name="overlapAnchor">false</item>
        <item name="android:dropDownWidth">wrap_content</item>
        <item name="android:background">?attr/colorSurfaceContainerHigh</item>
        <item name="android:dropDownVerticalOffset">5dp</item>
        <item name="android:dropDownHorizontalOffset">0dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="ToolBarStyle_white" parent="Widget.App.Toolbar.OnPrimary" />

    <style name="ActionSheetDialogStyle_No_Bg" parent="App.Material3.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowAnimationStyle">@style/ActionSheetDialogAnimation</item>
    </style>

    <style name="like_toast_dialog_style" parent="App.Material3.Dialog">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
