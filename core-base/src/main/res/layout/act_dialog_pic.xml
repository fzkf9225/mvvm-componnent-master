<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fl_pic"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/preview_viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true" />

    <LinearLayout
        android:id="@+id/ll_point"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal" />

    <!-- 仿微信右下角下载，略小于原 36dp -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_preview_download"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_preview_nav_circle"
        android:contentDescription="@string/preview_download"
        android:scaleType="centerInside"
        android:src="@drawable/ic_preview_download"
        app:shapeAppearanceOverlay="@style/CircleShapeAppearance" />

</FrameLayout>
