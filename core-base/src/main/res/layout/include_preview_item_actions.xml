<?xml version="1.0" encoding="utf-8"?>
<!-- 大图预览 item 右下角操作区：下载 + 查看全部。由 PreviewItemActionBinder 按 Host 契约显隐/绑定。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ll_preview_item_actions"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    tools:ignore="MissingConstraints">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_preview_download"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_preview_nav_circle"
        android:contentDescription="@string/preview_download"
        android:scaleType="centerInside"
        android:src="@drawable/ic_preview_download"
        android:visibility="gone"
        app:shapeAppearanceOverlay="@style/CircleShapeAppearance"
        tools:visibility="visible" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_preview_view_all"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/bg_preview_nav_circle"
        android:contentDescription="@string/view_all"
        android:scaleType="centerInside"
        android:src="@drawable/ic_preview_view_all"
        android:visibility="gone"
        app:shapeAppearanceOverlay="@style/CircleShapeAppearance"
        tools:visibility="visible" />
</LinearLayout>
