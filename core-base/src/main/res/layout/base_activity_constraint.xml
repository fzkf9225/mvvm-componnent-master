<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="toolbarConfig"
            type="io.coderf.arklab.common.bean.base.ToolbarConfig" />

        <import type="android.view.View" />

        <import type="androidx.core.content.ContextCompat" />

        <import type="io.coderf.arklab.common.R" />

        <variable
            name="context"
            type="android.content.Context" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/coordinator_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <io.coderf.arklab.common.widget.customview.ActionToolbar
            android:id="@+id/main_bar"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_width="match_parent"
            app:layout_constraintBottom_toTopOf="@+id/main_container"
            android:layout_height="?attr/actionBarSize"
            android:background="@{ContextCompat.getColor(context,toolbarConfig.bgColor)}"
            android:theme="@style/ToolBarStyle_black"
            app:contentInsetStart="0dp"
            app:contentInsetEnd="0dp"
            app:contentInsetStartWithNavigation="0dp"
            app:contentInsetEndWithActions="0dp"
            app:buttonGravity="center_vertical"
            app:bindNavIconVisible="@{toolbarConfig.showBackButton}"
            app:bindNavIconRes="@{toolbarConfig.backIconRes}"
            app:bindNavIconTint="@{ContextCompat.getColor(context, toolbarConfig.textColor)}"
            app:bindToolbarElevationDp="@{toolbarConfig.elevationDp}"
            app:popupTheme="@style/OverflowMenuStyle">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:ellipsize="end"
                android:text="@{toolbarConfig.title}"
                android:textColor="@{ContextCompat.getColor(context,toolbarConfig.textColor)}"
                app:bindTitleTextSizeSp="@{toolbarConfig.titleTextSizeSp}"
                app:bindTitleBold="@{toolbarConfig.titleBold}"
                app:bindTitleMaxLines="@{toolbarConfig.titleMaxLines}"
                app:bindTitleGravity="@{toolbarConfig.titleGravity}"
                app:bindTitleFontFamily="@{toolbarConfig.titleFontFamily}"
                app:bindTitleFontRes="@{toolbarConfig.titleFontRes}"
                app:bindTitleLetterSpacing="@{toolbarConfig.titleLetterSpacing}"
                app:bindTitleAllCaps="@{toolbarConfig.titleAllCaps}" />
        </io.coderf.arklab.common.widget.customview.ActionToolbar>

        <FrameLayout
            android:id="@+id/main_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintVertical_weight="1"
            app:layout_constraintTop_toBottomOf="@+id/main_bar"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
