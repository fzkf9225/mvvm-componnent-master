<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false">

        <io.coderf.arklab.common.widget.customview.CenteredIconContainer
            android:id="@+id/media_add"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:iconSizePercent="0.34"
            app:iconSrc="@mipmap/ic_tweet_add"
            app:layout_constraintDimensionRatio="w,1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_media_show"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:layout_constraintDimensionRatio="h,1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/RoundedShapeAppearanceS" />

        <io.coderf.arklab.common.widget.customview.CenteredIconContainer
            android:id="@+id/iv_player"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:iconSizePercent="0.34"
            app:iconSrc="@mipmap/icon_play"
            app:layout_constraintBottom_toBottomOf="@+id/iv_media_show"
            app:layout_constraintEnd_toEndOf="@+id/iv_media_show"
            app:layout_constraintStart_toStartOf="@+id/iv_media_show"
            app:layout_constraintTop_toTopOf="@+id/iv_media_show" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/upload_mark"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/iv_media_show"
            app:layout_constraintEnd_toEndOf="@+id/iv_media_show"
            app:layout_constraintStart_toStartOf="@+id/iv_media_show"
            app:layout_constraintTop_toTopOf="@+id/iv_media_show" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/upload_process"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="@dimen/font_size_l"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/upload_mark"
            app:layout_constraintEnd_toEndOf="@+id/upload_mark"
            app:layout_constraintStart_toStartOf="@+id/upload_mark"
            app:layout_constraintTop_toTopOf="@+id/upload_mark" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_clear_media"
            android:layout_width="@dimen/image_m"
            android:layout_height="@dimen/image_m"
            android:layout_gravity="end"
            android:layout_marginTop="-12dp"
            android:layout_marginEnd="-12dp"
            android:background="@drawable/ib_clear_image_selector"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
