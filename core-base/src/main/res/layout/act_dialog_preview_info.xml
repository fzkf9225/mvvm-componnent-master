<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_preview_info"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:clipChildren="false">

    <!-- 媒体与条目元数据（定位/标题/时间/定位文案）在 ViewPager item 内；此处仅保留翻页外壳 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/preview_info_viewPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_preview_prev"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_preview_nav_circle"
        android:contentDescription="@string/preview_previous"
        android:scaleType="centerInside"
        android:src="@drawable/ic_preview_prev"
        app:layout_constraintBottom_toBottomOf="@id/preview_info_viewPager"
        app:layout_constraintStart_toStartOf="@id/preview_info_viewPager"
        app:layout_constraintTop_toTopOf="@id/preview_info_viewPager"
        app:shapeAppearanceOverlay="@style/CircleShapeAppearance" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_preview_next"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_preview_nav_circle"
        android:contentDescription="@string/preview_next"
        android:scaleType="centerInside"
        android:src="@drawable/ic_preview_next"
        app:layout_constraintBottom_toBottomOf="@id/preview_info_viewPager"
        app:layout_constraintEnd_toEndOf="@id/preview_info_viewPager"
        app:layout_constraintTop_toTopOf="@id/preview_info_viewPager"
        app:shapeAppearanceOverlay="@style/CircleShapeAppearance" />

</androidx.constraintlayout.widget.ConstraintLayout>
