<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_preview_info"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:clipChildren="false">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_preview_location"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="@string/preview_location"
        android:scaleType="centerInside"
        android:src="@drawable/ic_preview_location"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/preview_info_viewPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toTopOf="@id/ll_preview_info"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_preview_location" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_preview_prev"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_preview_nav_circle"
        android:clipToOutline="true"
        android:contentDescription="@string/preview_previous"
        android:scaleType="centerInside"
        android:src="@drawable/ic_preview_prev"
        app:layout_constraintBottom_toBottomOf="@id/preview_info_viewPager"
        app:layout_constraintStart_toStartOf="@id/preview_info_viewPager"
        app:layout_constraintTop_toTopOf="@id/preview_info_viewPager"
        app:shapeAppearanceOverlay="@style/CircleShapeAppearance" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_preview_next"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_preview_nav_circle"
        android:clipToOutline="true"
        android:contentDescription="@string/preview_next"
        android:scaleType="centerInside"
        android:src="@drawable/ic_preview_next"
        app:layout_constraintBottom_toBottomOf="@id/preview_info_viewPager"
        app:layout_constraintEnd_toEndOf="@id/preview_info_viewPager"
        app:layout_constraintTop_toTopOf="@id/preview_info_viewPager"
        app:shapeAppearanceOverlay="@style/CircleShapeAppearance" />

    <LinearLayout
        android:id="@+id/ll_preview_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="72dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_preview_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            tools:text="河道巡检照片 · 可见光" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_preview_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp"
            tools:text="2026-01-28 14:40:00" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_preview_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp"
            tools:text="杭州市西湖区某河道" />
    </LinearLayout>

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_preview_view_all"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_preview_nav_circle"
        android:clipToOutline="true"
        android:contentDescription="@string/view_all"
        android:scaleType="center"
        android:src="@drawable/ic_preview_view_all"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:shapeAppearanceOverlay="@style/CircleShapeAppearance" />

</androidx.constraintlayout.widget.ConstraintLayout>
