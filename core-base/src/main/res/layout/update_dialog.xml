<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_update_dialog"
        android:paddingTop="4dp"
        android:paddingBottom="@dimen/vertical_margin_xxl">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="@dimen/vertical_margin_m"
            android:layout_marginEnd="@dimen/horizontal_margin_m"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:padding="8dp"
            android:src="@drawable/ic_dialog_close"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/updateTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/horizontal_margin_xxl"
            android:layout_marginTop="@dimen/vertical_margin_xxl"
            android:layout_marginEnd="@dimen/horizontal_margin_xxl"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/font_size_xxl"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="发现新版本" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvVersionChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vertical_margin_m"
            android:background="@drawable/bg_update_version_chip"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="@dimen/horizontal_margin_l"
            android:paddingTop="4dp"
            android:paddingEnd="@dimen/horizontal_margin_l"
            android:paddingBottom="4dp"
            android:textColor="?attr/colorPrimary"
            android:textSize="@dimen/font_size_xl"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/updateTitle"
            tools:text="V1.2.0"
            tools:visibility="visible" />

        <ScrollView
            android:id="@+id/scContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/horizontal_margin_xxl"
            android:layout_marginTop="@dimen/vertical_margin_l"
            android:layout_marginEnd="@dimen/horizontal_margin_xxl"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="vertical"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toTopOf="@id/updateBtn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_max="240dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvVersionChip"
            app:layout_constraintVertical_bias="0"
            app:layout_constraintVertical_chainStyle="packed">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/updateMsg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/font_size_xl"
                tools:text="1、优化性能体验\n2、修复已知问题\n详情请访问 https://example.com" />
        </ScrollView>

        <com.google.android.material.button.MaterialButton
            style="@style/Widget.App.Button.Flush"
            android:id="@+id/updateBtn"
            android:layout_width="0dp"
            android:layout_height="@dimen/height_xl"
            android:layout_marginStart="@dimen/horizontal_margin_xxl"
            android:layout_marginTop="@dimen/vertical_margin_xl"
            android:layout_marginEnd="@dimen/horizontal_margin_xxl"
            android:gravity="center"
            android:paddingVertical="0dp"
            android:text="@string/upgrade"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="@dimen/font_size_xxl"
            app:backgroundTint="?attr/colorPrimary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/scContent"
            app:cornerRadius="@dimen/radius_xxl" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
