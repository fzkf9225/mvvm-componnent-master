<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 弹框dialog - 使用Material3 -->
    <style name="ActionSheetDialogStyle" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <!-- 背景透明 -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <!-- 浮于Activity之上 -->
        <item name="android:windowIsFloating">true</item>
        <!-- 边框 -->
        <item name="android:windowFrame">@null</item>
        <!-- Dialog以外的区域模糊效果 -->
        <item name="android:backgroundDimEnabled">true</item>
        <!-- 无标题 -->
        <item name="android:windowNoTitle">true</item>
        <!-- 半透明 -->
        <item name="android:windowIsTranslucent">true</item>
        <!-- Dialog进入及退出动画 -->
        <item name="android:windowAnimationStyle">@style/ActionSheetDialogAnimation</item>
    </style>

    <!-- ActionSheet进出动画 - 使用Material3动画 -->
    <style name="ActionSheetDialogAnimation" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/actionsheet_dialog_in</item>
        <item name="android:windowExitAnimation">@anim/actionsheet_dialog_out</item>
    </style>

    <style name="Widget.App.Button.FormButton" parent="Widget.App.Button">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!--
      Form 控件默认样式。数值默认来自 dimens.xml，颜色在代码里回落到 ThemeAttrs。
      宿主可在 Theme 中设置：
        <item name="formStyle">@style/Widget.App.Form</item>
      或继承本 style 后覆盖部分 item，再挂到 formStyle。
      单控件 XML 上的 app:xxx 仍优先于 formStyle。
    -->
    <!-- parent="" 避免 AAPT 按点号隐式查找不存在的 Widget.App -->
    <style name="Widget.App.Form" parent="">
        <item name="formLabelTextSize">@dimen/form_label_text_size</item>
        <item name="formTextSize">@dimen/form_text_size</item>
        <item name="formRequiredSize">@dimen/form_required_size</item>
        <item name="labelStartMargin">@dimen/form_label_start_margin</item>
        <item name="labelEndMargin">@dimen/form_label_end_margin</item>
        <item name="labelTopMargin">@dimen/form_label_top_margin</item>
        <item name="labelBottomMargin">@dimen/form_label_bottom_margin</item>
        <item name="textStartMargin">@dimen/form_text_start_margin</item>
        <item name="textEndMargin">@dimen/form_text_end_margin</item>
        <item name="defaultTextMargin">@dimen/form_default_text_margin</item>
        <item name="borderBottomStartMargin">@dimen/form_border_bottom_start_margin</item>
        <item name="borderBottomEndMargin">@dimen/form_border_bottom_end_margin</item>
        <item name="bottomBorderHeight">@dimen/form_bottom_border_height</item>
        <item name="requiredStartMargin">@dimen/form_required_start_margin</item>
        <item name="labelIconStartMargin">@dimen/form_label_icon_start_margin</item>
        <item name="labelIconEndMargin">@dimen/form_label_icon_end_margin</item>
        <item name="bottomBorder">true</item>
        <item name="required">false</item>
        <item name="line">1</item>
        <item name="labelAlign">left</item>
        <item name="labelVerticalAlign">topToValue</item>
        <item name="textAlign">right</item>
        <item name="showLabelIcon">false</item>
    </style>
</resources>
