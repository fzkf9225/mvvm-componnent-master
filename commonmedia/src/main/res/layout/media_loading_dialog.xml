<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="message"
            type="java.lang.String" />
    </data>

    <LinearLayout
        android:id="@+id/ll_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/media_progress_dialog"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/media_padding_xxl"
        android:paddingEnd="@dimen/media_padding_xxl"
        android:paddingTop="@dimen/media_padding_xl"
        android:paddingBottom="@dimen/media_padding_xl">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="#FFFFFF"
            app:indicatorSize="@dimen/media_padding_xl"
            app:trackThickness="3dp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tipTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/media_vertical_margin_l"
            android:text="@={message}"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/media_font_size_xl" />
    </LinearLayout>
</layout>
