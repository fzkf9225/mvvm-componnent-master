<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme.SplashScreen" parent="Theme.SplashScreen">
        <!--背景颜色 - 使用语义颜色 -->
        <item name="windowSplashScreenBackground">?attr/colorSurface</item>
        <!--设置动画或图片,注意动画在Android12 以下不生效 很难受...-->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <!--动画执行时间-->
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/AppBaseTheme</item>
    </style>
    <style name="CollapsingToolbarTitleStyle" parent="TextAppearance.Material3.HeadlineMedium">
        <!-- 使用语义颜色 -->
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">@dimen/font_size_xxl</item>
    </style>
    <style name="ExpandedToolbarTitleStyle" parent="TextAppearance.Material3.HeadlineLarge">
        <!-- 展开标题使用白色以在图片上可见 -->
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">@dimen/font_size_xxxl</item>
    </style>

    <!-- 底部导航选中指示器样式 - 透明背景 -->
    <style name="NavIndicatorStyle" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>
</resources>
