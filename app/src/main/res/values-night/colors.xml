<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        暗色模式颜色兼容（app 模块）
        由于 app 模块自身 colors.xml 中定义了 white/black，这里需要重新覆盖。
        其他未在此列出的颜色（purple_xxx、teal_xxx）保持不变。
    -->

    <!-- 表面色（白色 → 深色） -->
    <color name="white">#FF1C1B1F</color>

    <!-- 文字色（黑色 → 浅色） -->
    <color name="black">#FFE6E1E5</color>

    <!--
        purple_200 / purple_500 / purple_700 / teal_200 / teal_700 / demo_green_*
        保持不变，因为它们是品牌色或功能色。
    -->
</resources>
