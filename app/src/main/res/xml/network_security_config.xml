<?xml version="1.0" encoding="utf-8"?>
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <!-- release：仅信任系统 CA，禁止明文 -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- 开发内网明文域名（仍不信任用户 CA） -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">192.168.1.68</domain>
        <domain includeSubdomains="true">192.168.0.10</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">n.sinaimg.cn</domain>
        <domain includeSubdomains="true">img1.baidu.com</domain>
        <domain includeSubdomains="true">bkimg.cdn.bcebos.com</domain>
        <domain includeSubdomains="true">q8.itc.cn/images01</domain>
        <domain includeSubdomains="true">ww1.sinaimg.cn</domain>
        <domain includeSubdomains="true">img2.baidu.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
