<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        tools:context=".activity.SpeakDemoActivity">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvIntro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/padding_m"
            android:lineSpacingExtra="4dp"
            android:text="core-speak：SpeakHelper.attach 挂到任意 View（本页为普通 MaterialButton）。按住说话；松手编辑区=回调；左上滑撤回、右上滑发送。列表点击播放，长按删除。"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/font_size_m"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/speak_smart_paging_fragment_view"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:defaultNavHost="true"
            app:layout_constraintBottom_toTopOf="@id/bottomBar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvIntro"
            app:navGraph="@navigation/speak_smart_paging_navigation" />

        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            android:elevation="4dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/padding_m"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- 普通按钮：语音能力由 SpeakHelper.attach 绑定，不依赖 SpeakButton -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSpeak"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/speak_hold_to_talk"
                android:textAllCaps="false" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
