<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="io.coderf.arklab.demo.bean.Person" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <io.coderf.arklab.common.widget.customview.SquareLabelView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lines="1"
            android:text="@{item.name}"
            android:textColor="@color/onSurfacePrimary"
            android:textSize="16sp"
            app:layout_constraintTop_toTopOf="parent"
            app:squareColor="@color/theme_green"
            app:squareCornerRadius="2dp"
            app:squareHeight="14dp"
            app:squarePosition="start"
            app:squareShape="round_rectangle"
            app:squareSpacing="8dp"
            app:squareWidth="3dp"
            tools:text="这是标题哦！！！！" />

        <io.coderf.arklab.ui.form.FormTextView
            android:id="@+id/tv_age"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vertical_margin_l"
            app:bottomBorder="false"
            app:defaultTextMargin="0dp"
            app:formTextColor="?attr/colorOnSurface"
            app:label="年龄："
            app:labelStartMargin="0dp"
            app:labelTextColor="#999999"
            app:layout_constraintEnd_toStartOf="@+id/tv_sex"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"
            app:line="1"
            app:required="false"
            app:text="@{item.age}"
            app:textAlign="left"
            app:textEndMargin="0dp"
            app:textStartMargin="0dp" />

        <io.coderf.arklab.ui.form.FormTextView
            android:id="@+id/tv_sex"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/horizontal_margin_xl"
            app:bottomBorder="false"
            app:defaultTextMargin="0dp"
            app:formTextColor="?attr/colorOnSurface"
            app:label="性别："
            app:labelStartMargin="0dp"
            app:labelTextColor="#999999"
            app:layout_constraintBottom_toBottomOf="@+id/tv_age"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/tv_age"
            app:layout_constraintTop_toTopOf="@+id/tv_age"
            app:line="1"
            app:required="false"
            app:text="@{item.sex}"
            app:textAlign="left"
            app:textEndMargin="0dp"
            app:textStartMargin="0dp" />

        <io.coderf.arklab.ui.form.FormTextView
            android:id="@+id/tv_birthday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vertical_margin_m"
            app:bottomBorder="false"
            app:defaultTextMargin="0dp"
            app:formTextColor="?attr/colorOnSurface"
            app:label="生日："
            app:labelStartMargin="0dp"
            app:labelTextColor="#999999"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_sex"
            app:line="1"
            app:required="false"
            app:text="@{item.birthday}"
            app:textAlign="left"
            app:textEndMargin="0dp"
            app:textStartMargin="0dp" />

        <io.coderf.arklab.ui.form.FormTextView
            android:id="@+id/tv_other"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vertical_margin_m"
            app:bottomBorder="false"
            app:defaultTextMargin="0dp"
            app:formTextColor="?attr/colorOnSurface"
            app:label="基本资料："
            app:labelStartMargin="0dp"
            app:labelTextColor="#999999"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_birthday"
            app:line="1"
            app:required="false"
            app:text="@{item.height +`/`+item.weight +`/`+item.email+`/`+item.tel}"
            app:textAlign="left"
            app:textEndMargin="0dp"
            app:textStartMargin="0dp" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>