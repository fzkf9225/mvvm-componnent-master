<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="data"
            type="io.coderf.arklab.demo.bean.Person" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        tools:context=".activity.VerifyActivity">

        <LinearLayout
            android:id="@+id/config_panel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            android:orientation="vertical"
            android:paddingStart="@dimen/padding_xl"
            android:paddingTop="@dimen/padding_m"
            android:paddingEnd="@dimen/padding_xl"
            android:paddingBottom="@dimen/padding_m"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="演示配置"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/font_size_xl"
                android:textStyle="bold" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vertical_margin_s"
                android:text="标签对齐"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/font_size_l" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_label_align"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_align_left"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="左侧" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_align_top"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="顶部" />
            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="正文对齐（仅左侧标签时生效）"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/font_size_l" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_text_align"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_text_right"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="居右" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_text_left"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="居左" />
            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="校验分组"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/font_size_l" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_verify_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_group_default"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Default" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_group_create"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Create" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_group_editor"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Editor" />
            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="收集模式"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/font_size_l" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_collect_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_mode_first"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="遇错即停" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_mode_all"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="收集全部" />
            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_verify_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vertical_margin_s"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/font_size_l"
                tools:text="Default：姓名必须为张三；座机必填；教育经历/开学/上课时间。" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/scroll_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="?attr/colorSurface"
            app:layout_constraintBottom_toTopOf="@+id/verify_submit"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/config_panel"
            app:layout_constraintVertical_weight="1">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/form_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <!--姓名-->
                <io.coderf.arklab.ui.form.FormEditText
                    android:id="@+id/edit_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:bottomBorder="true"
                    app:formImeOptions="actionNext"
                    app:formInputType="text"
                    app:hint="请输入姓名"
                    app:label="姓名"
                    app:labelAlign="left"
                    app:labelTextStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:required="true"
                    app:text="@={data.name}" />
                <!--性别-->
                <io.coderf.arklab.ui.form.FormSelection
                    android:id="@+id/tv_sex"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:bottomBorder="true"
                    app:formImeOptions="actionNext"
                    app:formInputType="text"
                    app:hint="请选择性别"
                    app:label="性别"
                    app:labelAlign="left"
                    app:labelTextStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/edit_name"
                    app:required="true"
                    app:text="@{data.sex}" />
                <!--学历 FormSpinner-->
                <io.coderf.arklab.ui.form.FormSpinner
                    android:id="@+id/form_education"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:bottomBorder="true"
                    app:hint="请选择学历"
                    app:label="学历"
                    app:labelAlign="left"
                    app:labelTextStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_sex"
                    app:required="true"
                    app:text="@={data.educationLevel}" />
                <!--订阅 FormSwitch-->
                <io.coderf.arklab.ui.form.FormSwitch
                    android:id="@+id/form_newsletter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:bottomBorder="true"
                    app:checked="@={data.acceptNewsletter}"
                    app:label="订阅资讯"
                    app:labelAlign="left"
                    app:labelTextStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/form_education"
                    app:switchThumbTint="@color/theme_green"
                    app:switchTrackTint="@color/demo_green_track" />
                <!--协议 FormCheckbox-->
                <io.coderf.arklab.ui.form.FormCheckbox
                    android:id="@+id/form_agree"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:bottomBorder="true"
                    app:checked="@={data.agreeProtocol}"
                    app:checkboxCheckedColor="@color/theme_green"
                    app:checkboxUncheckedColor="@color/theme_green"
                    app:label="同意用户协议"
                    app:labelAlign="left"
                    app:labelTextStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/form_newsletter"
                    app:required="true" />
                <!--联系方式 FormRadio-->
                <io.coderf.arklab.ui.form.FormRadio
                    android:id="@+id/form_contact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:bottomBorder="true"
                    app:label="联系偏好"
                    app:labelAlign="left"
                    app:labelTextStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/form_agree"
                    app:radioButtonTint="@color/theme_green"
                    app:radioUncheckedColor="@color/theme_green"
                    app:text="@={data.contactPreference}" />
                <!--步数 FormStepper-->
                <io.coderf.arklab.ui.form.FormStepper
                    android:id="@+id/form_steps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:bottomBorder="true"
                    app:label="每日步数"
                    app:labelAlign="left"
                    app:labelTextStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/form_contact"
                    app:stepperBtnBorderColor="@color/theme_green"
                    app:stepperIconColor="@color/theme_green"
                    app:stepperMax="50000"
                    app:stepperMin="0"
                    app:stepperStep="500"
                    app:stepperValue="@={data.dailySteps}" />
                <!--评分 FormRating-->
                <io.coderf.arklab.ui.form.FormRating
                    android:id="@+id/form_rating"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:bottomBorder="true"
                    app:label="服务评分"
                    app:labelAlign="left"
                    app:labelTextStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/form_steps"
                    app:ratingCount="5"
                    app:ratingEmptyStarColor="@color/demo_green_empty_star"
                    app:ratingStarColor="@color/theme_green"
                    app:ratingValue="@={data.serviceRating}" />
                <!--生日-->
                <io.coderf.arklab.ui.form.FormDate
                    android:id="@+id/tv_birthday"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:bottomBorder="true"
                    app:confirmTextColor="@color/theme_green"
                    app:endYear="2030"
                    app:formImeOptions="actionNext"
                    app:formInputType="text"
                    app:hint="请选择生日"
                    app:datePickerUi="wheel"
                    app:label="生日"
                    app:labelAlign="left"
                    app:labelTextStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/form_rating"
                    app:required="true"
                    app:startYear="1990"
                    app:text="@={data.birthday}" />
                <!--教育经历-->
                <io.coderf.arklab.ui.form.FormDateRange
                    android:id="@+id/tv_educational_experience_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:bottomBorder="true"
                    app:calendarMode="range"
                    app:confirmTextColor="@color/theme_green"
                    app:selectableEndDate="2030-12-31"
                    app:formImeOptions="actionNext"
                    app:formInputType="text"
                    app:hint="请选择大学在读时间"
                    app:label="教育经历"
                    app:labelAlign="left"
                    app:labelTextStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_birthday"
                    app:normalBg="@drawable/calendar_day_bg_normal"
                    app:required="true"
                    app:selectedBg="@drawable/calendar_day_bg_focused"
                    app:selectedTextColor="?attr/colorOnPrimary"
                    app:showDot="false"
                    app:selectableStartDate="2024-01-01"
                    app:bottomTagTextColor="@color/theme_green"
                    app:text="@={data.educationalExperienceDate}"
                    app:weekTextColor="@color/theme_red"
                    app:workingDayTextColor="?attr/colorOnSurface" />
                <!--开学时间-->
                <io.coderf.arklab.ui.form.FormDateTime
                    android:id="@+id/tv_school_start_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:bottomBorder="true"
                    app:confirmTextColor="@color/theme_green"
                    app:endYear="2030"
                    app:formImeOptions="actionNext"
                    app:formInputType="text"
                    app:hint="请选择开学时间"
                    app:label="开学时间"
                    app:labelAlign="left"
                    app:labelTextStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_educational_experience_date"
                    app:required="true"
                    app:startYear="1990"
                    app:text="@={data.schoolStartTime}" />
                <!--每天上课时间-->
                <io.coderf.arklab.ui.form.FormTime
                    android:id="@+id/tv_class_start_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:bottomBorder="true"
                    app:confirmTextColor="@color/theme_green"
                    app:endYear="2030"
                    app:formImeOptions="actionNext"
                    app:formInputType="text"
                    app:hint="请选择上课时间"
                    app:datePickerUi="wheel"
                    app:label="上课时间"
                    app:labelAlign="left"
                    app:labelTextStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_school_start_time"
                    app:required="true"
                    app:startYear="1990"
                    app:text="@={data.classStartTime}" />
                <!--手机号码-->
                <io.coderf.arklab.ui.form.FormEditText
                    android:id="@+id/edit_mobile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:bottomBorder="true"
                    app:formImeOptions="actionNext"
                    app:formInputType="number"
                    app:hint="请输入手机号码"
                    app:label="手机号码"
                    app:labelAlign="left"
                    app:labelTextStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_class_start_time"
                    app:required="true"
                    app:text="@={data.mobile}" />
                <!--座机-->
                <io.coderf.arklab.ui.form.FormEditText
                    android:id="@+id/edit_tel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:bottomBorder="true"
                    app:formImeOptions="actionNext"
                    app:formInputType="number"
                    app:hint="请输入座机号码"
                    app:label="座机号码"
                    app:labelAlign="left"
                    app:labelTextStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/edit_mobile"
                    app:required="true"
                    app:text="@={data.tel}" />
                <!--年龄-->
                <io.coderf.arklab.ui.form.FormEditText
                    android:id="@+id/edit_age"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:bottomBorder="true"
                    app:formImeOptions="actionNext"
                    app:formInputType="number"
                    app:hint="请输入年龄"
                    app:label="年龄"
                    app:labelAlign="left"
                    app:labelTextStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/edit_tel"
                    app:required="true"
                    app:text="@={data.age}" />

                <!--体重-->
                <io.coderf.arklab.ui.form.FormEditText
                    android:id="@+id/edit_weight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:bottomBorder="true"
                    app:digits="2"
                    app:formImeOptions="actionNext"
                    app:formInputType="numberDecimal"
                    app:hint="请输入体重，示例：50.00（单位：kg）"
                    app:label="体重"
                    app:labelAlign="left"
                    app:labelTextStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/edit_age"
                    app:maxLength="6"
                    app:required="true"
                    app:text="@={data.weight}" />

                <!--身高-->
                <io.coderf.arklab.ui.form.FormEditText
                    android:id="@+id/edit_height"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:bottomBorder="true"
                    app:digits="2"
                    app:formImeOptions="actionNext"
                    app:formInputType="numberDecimal"
                    app:hint="请输入身高，示例：170（单位：厘米）"
                    app:label="身高"
                    app:labelAlign="left"
                    app:labelTextStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/edit_weight"
                    app:maxLength="6"
                    app:required="true"
                    app:text="@={data.height}" />
                <!--邮箱-->
                <io.coderf.arklab.ui.form.FormEditText
                    android:id="@+id/edit_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:bottomBorder="true"
                    app:formImeOptions="actionNext"
                    app:formInputType="text"
                    app:hint="请输入邮箱，示例：tencent@qq.com"
                    app:formHelperText="示例：tencent@qq.com"
                    app:label="邮箱"
                    app:labelAlign="left"
                    app:labelTextStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/edit_height"
                    app:required="true"
                    app:text="@={data.email}" />

                <!--紧急联系人（Create：年龄≥18 时必填）-->
                <io.coderf.arklab.ui.form.FormEditText
                    android:id="@+id/edit_emergency_contact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:bottomBorder="true"
                    app:formImeOptions="actionNext"
                    app:formInputType="text"
                    app:hint="Create 分组下年龄≥18 时必填"
                    app:label="紧急联系人"
                    app:labelAlign="left"
                    app:labelTextStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/edit_email"
                    app:required="false"
                    app:text="@={data.emergencyContact}" />

                <!--配偶姓名 @VerifyWhenAll-->
                <io.coderf.arklab.ui.form.FormEditText
                    android:id="@+id/edit_spouse_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:bottomBorder="true"
                    app:formImeOptions="actionNext"
                    app:formInputType="text"
                    app:hint="Create：订阅资讯的女性必填"
                    app:label="配偶姓名"
                    app:labelAlign="left"
                    app:labelTextStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/edit_emergency_contact"
                    app:required="false"
                    app:text="@={data.spouseName}" />

                <!--身份证 ID_CARD-->
                <io.coderf.arklab.ui.form.FormEditText
                    android:id="@+id/edit_id_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:bottomBorder="true"
                    app:formImeOptions="actionNext"
                    app:formInputType="text"
                    app:hint="请输入身份证号"
                    app:label="身份证号"
                    app:labelAlign="left"
                    app:labelTextStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/edit_spouse_name"
                    app:required="false"
                    app:text="@={data.idCard}" />

                <!--个人主页 URL-->
                <io.coderf.arklab.ui.form.FormEditText
                    android:id="@+id/edit_homepage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:bottomBorder="true"
                    app:formHelperText="示例：https://www.example.com"
                    app:formImeOptions="actionNext"
                    app:formInputType="text"
                    app:hint="请输入个人主页"
                    app:label="个人主页"
                    app:labelAlign="left"
                    app:labelTextStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/edit_id_card"
                    app:required="false"
                    app:text="@={data.homepage}" />

                <!--邮政编码-->
                <io.coderf.arklab.ui.form.FormEditText
                    android:id="@+id/edit_postal_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:bottomBorder="true"
                    app:formImeOptions="actionNext"
                    app:formInputType="number"
                    app:hint="请输入6位邮编"
                    app:label="邮政编码"
                    app:labelAlign="left"
                    app:labelTextStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/edit_homepage"
                    app:required="false"
                    app:text="@={data.postalCode}" />

                <!--昵称 NOT_EQUALS / NOT_IN / REGEX-->
                <io.coderf.arklab.ui.form.FormEditText
                    android:id="@+id/edit_nickname"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:bottomBorder="true"
                    app:formHelperText="不能是 admin/root/system"
                    app:formImeOptions="actionNext"
                    app:formInputType="text"
                    app:hint="请输入昵称"
                    app:label="昵称"
                    app:labelAlign="left"
                    app:labelTextStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/edit_postal_code"
                    app:required="true"
                    app:text="@={data.nickname}" />

                <!--备注 Editor LENGTH_RANGE-->
                <io.coderf.arklab.ui.form.FormEditText
                    android:id="@+id/edit_remark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:bottomBorder="true"
                    app:formImeOptions="actionNext"
                    app:formInputType="text"
                    app:hint="Editor 分组必填，长度 5-79"
                    app:label="备注"
                    app:labelAlign="left"
                    app:labelTextStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/edit_nickname"
                    app:required="false"
                    app:text="@={data.remark}" />

                <!--妻子 @Valid 嵌套-->
                <io.coderf.arklab.ui.form.FormEditText
                    android:id="@+id/edit_wife"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:bottomBorder="true"
                    app:formImeOptions="actionNext"
                    app:formInputType="text"
                    app:hint="Create 分组嵌套校验 Family.wife"
                    app:label="妻子"
                    app:labelAlign="left"
                    app:labelTextStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/edit_remark"
                    app:required="false"
                    app:text="@={data.wife}" />

                <!--丈夫 @Valid 嵌套-->
                <io.coderf.arklab.ui.form.FormEditText
                    android:id="@+id/edit_husband"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:bottomBorder="true"
                    app:formImeOptions="actionNext"
                    app:formInputType="text"
                    app:hint="Create 分组嵌套校验 Family.husband"
                    app:label="丈夫"
                    app:labelAlign="left"
                    app:labelTextStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/edit_wife"
                    app:required="false"
                    app:text="@={data.husband}" />

                <!--爱好-->
                <io.coderf.arklab.ui.form.FormEditArea
                    android:id="@+id/edit_hobby"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:bottomBorder="true"
                    app:formImeOptions="actionNext"
                    app:formCounterEnabled="true"
                    app:formHelperText="多个爱好以“、”隔开"
                    app:formInputType="textMultiLine"
                    app:hint="请输入爱好,多个爱好以“、”隔开"
                    app:inputDrawable="@drawable/bg_edittext"
                    app:label="爱好"
                    app:maxLength="50"
                    app:labelAlign="left"
                    app:labelTextStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/edit_husband"
                    app:required="true" />
                <!--本人照片-->
                <io.coderf.arklab.ui.form.FormImage
                    android:id="@+id/form_image"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:itemBgColor="?attr/colorPrimary"
                    app:bottomBorder="true"
                    app:compress="false"
                    app:compressImageSize="800"
                    app:formImeOptions="actionNext"
                    app:label="本人照片"
                    app:autoUpload="true"
                    app:labelTextStyle="bold"
                    app:columnMargin="16dp"
                    app:clearImageTopMargin="-8dp"
                    app:clearImageEndMargin="-8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/edit_hobby"
                    app:mediaItemRadius="@dimen/radius_m"
                    app:mediaType="camera_album"
                    app:required="false" />
                <!--本人视频-->
                <io.coderf.arklab.ui.form.FormVideo
                    android:id="@+id/form_video"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:itemBgColor="?attr/colorPrimary"
                    app:bottomBorder="true"
                    app:compress="true"
                    app:compress_video="low"
                    app:formImeOptions="actionNext"
                    app:label="本人视频"
                    app:columnMargin="16dp"
                    app:clearImageTopMargin="-8dp"
                    app:clearImageEndMargin="-8dp"
                    app:labelTextStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/form_image"
                    app:mediaItemRadius="@dimen/radius_m"
                    app:mediaType="camera_album"
                    app:required="false" />
                <!--家庭照片视频-->
                <io.coderf.arklab.ui.form.FormImageAndVideo
                    android:id="@+id/form_image_video"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:itemBgColor="?attr/colorPrimary"
                    app:bottomBorder="true"
                    app:compress="true"
                    app:compress_video="low"
                    app:formImeOptions="actionNext"
                    app:label="家庭照片视频"
                    app:columnMargin="16dp"
                    app:clearImageTopMargin="-8dp"
                    app:clearImageEndMargin="-8dp"
                    app:labelTextStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/form_video"
                    app:mediaItemRadius="@dimen/radius_m"
                    app:mediaType="media_camera_shoot_album"
                    app:required="false" />
                <!--荣誉证书-->
                <io.coderf.arklab.ui.form.FormFile
                    android:id="@+id/form_file"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:itemBgColor="?attr/colorSurfaceVariant"
                    app:bottomBorder="true"
                    app:compress="true"
                    app:compress_video="low"
                    app:formImeOptions="actionNext"
                    app:label="荣誉证书"
                    app:labelTextStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/form_image_video"
                    app:mediaItemRadius="@dimen/radius_s"
                    app:mediaType="camera_album"
                    app:required="false" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/verify_submit"
            style="@style/Widget.App.Button.TextButton"
            app:cornerRadius="0dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_xxxl"
            app:backgroundTint="?attr/colorPrimary"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="校验"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="@dimen/font_size_xxl"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/scroll_view" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>