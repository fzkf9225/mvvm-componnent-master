<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="data"
            type="io.coderf.arklab.demo.bean.FormBean" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        tools:context=".activity.FormDetailActivity">

        <LinearLayout
            android:id="@+id/config_panel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            android:orientation="vertical"
            android:paddingStart="@dimen/padding_l"
            android:paddingTop="@dimen/padding_s"
            android:paddingEnd="@dimen/padding_l"
            android:paddingBottom="@dimen/padding_s"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="28dp"
                    android:text="标签"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/font_size_l" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_label_align"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/padding_s"
                    android:layout_weight="1"
                    app:chipSpacingHorizontal="@dimen/padding_s"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_align_left"
                        style="@style/Widget.App.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="左侧"
                        android:textSize="@dimen/font_size_l"
                        app:checkedIconVisible="false"
                        app:chipMinHeight="28dp"
                        app:ensureMinTouchTargetSize="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_align_top"
                        style="@style/Widget.App.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="顶部"
                        android:textSize="@dimen/font_size_l"
                        app:checkedIconVisible="false"
                        app:chipMinHeight="28dp"
                        app:ensureMinTouchTargetSize="false" />
                </com.google.android.material.chip.ChipGroup>

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/padding_m"
                    android:minWidth="28dp"
                    android:text="正文"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/font_size_l" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_text_align"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/padding_s"
                    android:layout_weight="1"
                    app:chipSpacingHorizontal="@dimen/padding_s"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_text_right"
                        style="@style/Widget.App.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="居右"
                        android:textSize="@dimen/font_size_l"
                        app:checkedIconVisible="false"
                        app:chipMinHeight="28dp"
                        app:ensureMinTouchTargetSize="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_text_left"
                        style="@style/Widget.App.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="居左"
                        android:textSize="@dimen/font_size_l"
                        app:checkedIconVisible="false"
                        app:chipMinHeight="28dp"
                        app:ensureMinTouchTargetSize="false" />
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>
        </LinearLayout>

        <ScrollView
            android:id="@+id/scroll_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="?attr/colorSurface"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/config_panel">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/form_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <!--简报名称-->
                <io.coderf.arklab.ui.form.FormTextView
                    android:id="@+id/tv_bulletin_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:bottomBorder="true"
                    app:label="简报名称"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:line="-1"
                    app:required="false"
                    app:text="@{data.title}" />
                <!--简报提交时间-->
                <io.coderf.arklab.ui.form.FormTextView
                    android:id="@+id/tv_bulletin_create_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:bottomBorder="true"
                    app:label="简报提交时间"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_bulletin_name"
                    app:line="-1"
                    app:required="false"
                    app:text="@{data.date}" />
                <!--简报内容-->
                <io.coderf.arklab.ui.form.FormTextView
                    android:id="@+id/tv_bulletin_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:bottomBorder="true"
                    app:label="简报内容"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_bulletin_create_time"
                    app:line="-1"
                    app:required="false"
                    app:text="@{data.content}" />
                <!--富文本-->
                <io.coderf.arklab.ui.form.FormRichText
                    android:id="@+id/tv_rich_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:bottomBorder="true"
                    app:label="富文本"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_bulletin_detail"
                    app:line="-1"
                    app:required="false"
                    app:text="@{data.richText}" />

                <!--现场图片-->
                <io.coderf.arklab.ui.form.FormImagePreview
                    android:id="@+id/form_screen_image"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:bottomBorder="true"
                    app:label="现场图片"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_rich_text"
                    app:required="false" />

                <!--现场视频-->
                <io.coderf.arklab.ui.form.FormVideoPreview
                    android:id="@+id/form_screen_video"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:bottomBorder="true"
                    app:label="现场视频"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/form_screen_image"
                    app:required="false" />

                <!--图片视频混合-->
                <io.coderf.arklab.ui.form.FormImageAndVideoPreview
                    android:id="@+id/form_image_video"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:bottomBorder="true"
                    app:label="图片视频混合"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/form_screen_video"
                    app:required="false" />

                <!--其他附件-->
                <io.coderf.arklab.ui.form.FormFilePreview
                    android:id="@+id/form_screen_file"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:bottomBorder="false"
                    app:fileDrawable="@mipmap/icon_file"
                    app:label="其他附件"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/form_image_video"
                    app:required="false" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
