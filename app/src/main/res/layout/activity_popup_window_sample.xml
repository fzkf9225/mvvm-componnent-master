<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        android:fillViewport="true"
        tools:context=".activity.PopupWindowSampleActivity">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PopupWindow 封装演示（静态模拟数据）。Exposed Dropdown 走 M3 简单单选；其余为自研 Popup。"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />

            <!-- Exposed Dropdown -->
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="1. Exposed Dropdown（简单单选）"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/exposedDropdownLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="选择城市">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/exposedDropdownText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvExposedResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="未选择"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />

            <!-- PopupView -->
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="2. PopupView（竖向单选下拉）"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:textStyle="bold" />

            <io.coderf.arklab.common.widget.popupwindow.TextPopupView
                android:id="@+id/tvPopupView"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="?attr/colorSurfaceContainerHigh"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                app:endDrawable="@mipmap/icon_down"
                app:hiltText="请选择城市"
                app:hiltTextColor="?attr/colorOnSurfaceVariant" />

            <!-- MultiPopupView -->
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="3. MultiPopupView（网格多选）"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:textStyle="bold" />

            <io.coderf.arklab.common.widget.popupwindow.TextPopupView
                android:id="@+id/tvMultiPopup"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="?attr/colorSurfaceContainerHigh"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                app:endDrawable="@mipmap/icon_down"
                app:hiltText="请选择材质"
                app:hiltTextColor="?attr/colorOnSurfaceVariant" />

            <!-- TreePopupView -->
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="4. TreePopupView（左右树）"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:textStyle="bold" />

            <io.coderf.arklab.common.widget.popupwindow.TextPopupView
                android:id="@+id/tvTreePopup"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="?attr/colorSurfaceContainerHigh"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                app:endDrawable="@mipmap/icon_down"
                app:hiltText="请选择性别偏好"
                app:hiltTextColor="?attr/colorOnSurfaceVariant" />

            <!-- Cascade Single -->
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="5. CascadeSinglePopupWindow（级联单选）"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCascadeSingle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="打开级联单选"
                android:textAllCaps="false" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvCascadeSingleResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="未选择"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />

            <!-- Cascade Multi -->
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="6. CascadeMultiPopupWindow（级联多选）"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCascadeMulti"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="打开级联多选"
                android:textAllCaps="false" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvCascadeMultiResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="24dp"
                android:text="未选择"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>
</layout>
