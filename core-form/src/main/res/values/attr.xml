<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="TickView">
        <!--没有选中的基调颜色-->
        <attr name="uncheck_base_color" format="color" />
        <!--选中后的基调颜色-->
        <attr name="check_base_color" format="color" />
        <!--选中后钩的颜色-->
        <attr name="check_tick_color" format="color" />
        <!--圆的半径-->
        <attr name="radius" format="dimension" />
        <!--动画执行的速度-->
        <attr name="rate">
            <enum name="slow" value="0" />
            <enum name="normal" value="1" />
            <enum name="fast" value="2" />
        </attr>
        <attr name="clickable" format="boolean" />
    </declare-styleable>
    <!-- 主题级 Form 默认样式，宿主在 Theme 中设置 formStyle 即可全局生效 -->
    <attr name="formStyle" format="reference" />
    <!--label文字内容-->
    <attr name="label" format="string" />
    <!--是否展示*，提示必填-->
    <attr name="required" format="boolean" />
    <!-- 必填标记文字，默认 * -->
    <attr name="requiredText" format="string" />
    <!-- 必填标记颜色，默认 ThemeAttrs.error -->
    <attr name="requiredTextColor" format="reference|color" />
    <!--输入框最大文本输入长度-->
    <attr name="maxLength" format="integer" />
    <!--开始年度，例如：2025-->
    <attr name="startYear" format="integer" />
    <!--结束年度，例如：2027-->
    <attr name="endYear" format="integer" />
    <!--是否展示表单底部边框-->
    <attr name="bottomBorder" format="boolean" />
    <!--底部边框颜色-->
    <attr name="borderBottomColor" format="reference|color" />
    <!--底部边框高度，默认 1dp-->
    <attr name="bottomBorderHeight" format="dimension" />
    <!--底部边框左侧margin-->
    <attr name="borderBottomStartMargin" format="dimension" />
    <!--当主文本超过一行的时候，需要设置margin不然就会导致多个控件上下挤在一起-->
    <attr name="defaultTextMargin" format="dimension" />
    <!--输入框高度，当对齐方式为top的时候起作用-->
    <attr name="inputHeight" format="dimension" />
    <!--多行文本输入框内部padding-->
    <attr name="editAreaPadding" format="dimension" />
    <!--底部边框右侧margin-->
    <attr name="borderBottomEndMargin" format="dimension" />
    <!--label文字左侧margin-->
    <attr name="labelStartMargin" format="dimension" />
    <!--label文字右侧margin-->
    <attr name="labelEndMargin" format="dimension" />
    <!--label文字左侧margin-->
    <attr name="labelTopMargin" format="dimension" />
    <!--label文字右侧margin-->
    <attr name="labelBottomMargin" format="dimension" />
    <!--正文文字左侧margin-->
    <attr name="textStartMargin" format="dimension" />
    <!--正文文字右侧margin-->
    <attr name="textEndMargin" format="dimension" />
    <!--空白内容时，占用的文字颜色-->
    <attr name="emptyTextColor" format="reference|color" />
    <!--label文字颜色-->
    <attr name="labelTextColor" format="reference|color" />
    <!--确认按钮颜色-->
    <attr name="confirmTextColor" format="reference|color" />
    <!--DatePickDialog 右上角「今天/此刻」文字颜色-->
    <attr name="todayTextColor" format="reference|color" />
    <!--DatePickDialog 左上角清空按钮文字颜色-->
    <attr name="clearTextColor" format="reference|color" />
    <!--DatePickDialog 右上角「今天/此刻」文字大小 (sp)-->
    <attr name="todayTextSize" format="float" />
    <!--DatePickDialog 左上角清空按钮文字大小 (sp)-->
    <attr name="clearTextSize" format="float" />
    <!--DatePickDialog 左上角清空按钮文字-->
    <attr name="clearText" format="string" />
    <!--DatePickDialog 取消按钮文字颜色-->
    <attr name="negativeTextColor" format="reference|color" />
    <!--DatePickDialog 标题-->
    <attr name="datePickTitle" format="string" />
    <!--DatePickDialog 标题文字颜色-->
    <attr name="datePickTitleTextColor" format="reference|color" />
    <!--DatePickDialog 标题文字大小 (sp)-->
    <attr name="datePickTitleTextSize" format="float" />
    <!--DatePickDialog 标题顶部间距-->
    <attr name="datePickTitleMarginTop" format="dimension" />
    <!--DateRangePickDialog 月份文字颜色-->
    <attr name="calendarMonthTextColor" format="reference|color" />
    <!--DateRangePickDialog 月份文字大小 (sp)-->
    <attr name="calendarMonthTextSize" format="float" />
    <!--DatePickDialog 确定按钮文字大小 (sp)-->
    <attr name="positiveButtonTextSize" format="float" />
    <!--DatePickDialog 取消按钮文字大小 (sp)-->
    <attr name="negativeButtonTextSize" format="float" />
    <!--DatePickDialog 年/月/日等单位标签文字颜色-->
    <attr name="unitLabelTextColor" format="reference|color" />
    <!--DatePickDialog 年/月/日等单位标签文字大小 (sp)-->
    <attr name="unitLabelTextSize" format="float" />
    <!--DatePickDialog 底部按钮栏顶部间距-->
    <attr name="buttonBarMarginTop" format="dimension" />
    <!--DatePickDialog 根布局水平内边距 (start/end)-->
    <attr name="dialogPaddingHorizontal" format="dimension" />
    <!--DatePickDialog 滚轮分割线高度-->
    <attr name="dividerHeight" format="dimension" />
    <!--DatePickDialog 确定按钮文字-->
    <attr name="positiveText" format="string" />
    <!--DatePickDialog 取消按钮文字-->
    <attr name="negativeText" format="string" />
    <!--DatePickDialog 起始月份-->
    <attr name="startMonth" format="integer" />
    <!--DatePickDialog 结束月份-->
    <attr name="endMonth" format="integer" />
    <!--DatePickDialog 是否允许点击外部关闭-->
    <attr name="canOutSideDialog" format="boolean" />
    <!--DatePickDialog 是否显示确定按钮-->
    <attr name="showPositiveButton" format="boolean" />
    <!--DatePickDialog 是否显示取消按钮-->
    <attr name="showNegativeButton" format="boolean" />
    <!--DatePickDialog 弹出位置-->
    <attr name="datePickGravity" format="enum">
        <enum name="top" value="48" />
        <enum name="center" value="17" />
        <enum name="bottom" value="80" />
    </attr>
    <!--label文字大小-->
    <attr name="formLabelTextSize" format="dimension" />
    <!--输入框、选择框、文本内容文字颜色-->
    <attr name="formTextColor" format="reference|color" />
    <!--输入框、选择框、文本内容文字颜色-->
    <attr name="formHintTextColor" format="reference|color" />
    <!--输入框、选择框、文本内容文字大小-->
    <attr name="formTextSize" format="dimension" />
    <!--*号大小-->
    <attr name="formRequiredSize" format="dimension" />
    <!--弹框整体背景样式，drawable-->
    <attr name="dialogBgDrawable" format="reference" />
    <!--input输入框样式，drawable-->
    <attr name="inputDrawable" format="reference" />

    <declare-styleable name="FormUI">
        <!--默认的添加图标资源-->
        <attr name="fileAddSrc" format="reference"/>
        <!--文件前面的图标-->
        <attr name="fileDrawable" format="reference"/>
        <!--是否展示文件前面的图标-->
        <attr name="isShowFileDrawable" format="boolean"/>
        <!--空白内容时，占用的文字颜色-->
        <attr name="emptyTextColor"/>
        <!--矩形框圆角大小-->
        <attr name="mediaItemRadius" format="dimension"/>
        <!--是否默认开启压缩-->
        <attr name="compress" format="boolean"/>
        <!--压缩图片大小，单位kb-->
        <attr name="compressImageSize" format="integer" />
        <!--列表/宫格小图是否优先加载缩略图，默认为true；无缩略图时回退原图。大图预览不受影响-->
        <attr name="preferThumbnail" format="boolean"/>
        <!--最大可选数量-->
        <attr name="maxCount" format="integer"/>
        <!-- required 校验时最少条数，默认 1；仅 FormMedia.validate 使用 -->
        <attr name="minCount" format="integer"/>
        <!-- false 时等同 setEnabled(false)；未设置保持现状 -->
        <attr name="formEditable" format="boolean"/>
        <!--拍摄视频最大时长，单位：秒，默认为30秒-->
        <attr name="maxVideoDuration" format="integer"/>
        <!--一列显示几个-->
        <attr name="columnCount" format="integer"/>
        <!--列之间间距-->
        <attr name="columnMargin" format="dimension"/>
        <!--字段名，AttachmentUtil自动转换-->
        <attr name="field" format="string"/>
        <!--添加图片视频的时候，框框背景色-->
        <attr name="itemBgColor" format="color" />
        <!-- 右上角占位按钮图片 -->
        <attr name="clearImage" format="reference"/>
        <!-- 默认右上角占位按钮图片宽度 -->
        <attr name="clearImageWidth" format="dimension"/>
        <!-- 默认右上角占位按钮图片高度 -->
        <attr name="clearImageHeight" format="dimension"/>
        <!-- 默认右上角占位按钮图片topMargin -->
        <attr name="clearImageTopMargin" format="dimension"/>
        <!-- 默认右上角占位按钮图片endMargin -->
        <attr name="clearImageEndMargin" format="dimension"/>
        <!-- 是否展示label左侧图标，默认false -->
        <attr name="showLabelIcon" format="boolean"/>
        <!-- label左侧图标 -->
        <attr name="labelIcon" format="reference"/>
        <!-- label左侧图标宽度 -->
        <attr name="labelIconWidth" format="dimension"/>
        <!-- label左侧图标高度 -->
        <attr name="labelIconHeight" format="dimension"/>
        <!-- 文件左侧图标宽度 -->
        <attr name="fileIconWidth" format="dimension"/>
        <!-- 文件左侧图标高度 -->
        <attr name="fileIconHeight" format="dimension"/>
        <!-- label左侧图标endMargin -->
        <attr name="labelIconEndMargin" format="dimension"/>
        <!-- label左侧图标startMargin -->
        <attr name="labelIconStartMargin" format="dimension"/>
        <!-- required*号控件的左侧margin -->
        <attr name="requiredStartMargin" format="dimension"/>
        <!--媒体样式-->
        <attr name="mediaType">
            <!--相册、拍照兼具-->
            <enum name="camera_album" value="3" />
            <!--仅拍照或录像-->
            <enum name="camera" value="1" />
            <!--仅相册-->
            <enum name="album" value="2" />
            <!--图片、视频同时选择时的参数，仅拍照-->
            <enum name="media_camera" value="1" />
            <!--图片、视频同时选择时的参数，仅摄像-->
            <enum name="media_shoot" value="2" />
            <!--图片、视频同时选择时的参数，仅相册-->
            <enum name="media_album" value="3" />
            <!--图片、视频同时选择时的参数，仅拍照摄像-->
            <enum name="media_camera_shoot" value="4" />
            <!--图片、视频同时选择时的参数，相册、拍照、录像都显示-->
            <enum name="media_camera_shoot_album" value="5" />
        </attr>
        <!--视频压缩质量-->
        <attr name="compress_video" format="enum">
            <!--高质量，即压缩比例小-->
            <enum name="high" value="1" />
            <!--中等质量-->
            <enum name="medium" value="2" />
            <!--低质量，即压缩比例最大-->
            <enum name="low" value="3" />
        </attr>
        <!--label文字对齐方式，默认为左侧-->
        <attr name="labelAlign" format="enum">
            <enum name="left" value="0" />
            <enum name="top" value="1" />
        </attr>
        <!--表单中label文字对齐方式，当对齐方式为左侧时，他的垂直方向对齐方式-->
        <attr name="labelVerticalAlign" format="enum">
            <enum name="top" value="0" />
            <enum name="topToValue" value="1" />
            <enum name="center" value="2" />
            <enum name="bottom" value="3" />
        </attr>
        <!--正文文字对齐方式，默认为右侧，只有labelAlign在左侧时才有效-->
        <attr name="textAlign" format="enum">
            <enum name="left" value="0" />
            <enum name="right" value="1" />
        </attr>
        <!-- Default text typeface style. -->
        <attr name="labelTextStyle"/>
        <!--label文字内容-->
        <attr name="label" />
        <!--文件自定义保存的子目录名-->
        <attr name="saveSubPath" format="string" />
        <!--下拉框图标-->
        <attr name="selectionIcon" format="reference"/>
        <!--下拉框图标宽度，未设置时自适应图标原始尺寸-->
        <attr name="selectionIconWidth" format="dimension"/>
        <!--下拉框图标高度，未设置时自适应图标原始尺寸-->
        <attr name="selectionIconHeight" format="dimension"/>
        <!--下拉框图标与文字间距-->
        <attr name="selectionIconPadding" format="dimension"/>
        <!--占位图片-->
        <attr name="placeholderImage" format="reference"/>
        <!--加载错误图片-->
        <attr name="errorImage" format="reference"/>
        <!--是否自动上传-->
        <attr name="autoUpload" format="boolean"/>
        <!--是否隐藏顶部layout，也就是顶部的标签栏和数量栏，默认为false，也就是展示-->
        <attr name="hideTopLabelLayout" format="boolean"/>
        <!--是否必填，也就是是否显示必填的*号-->
        <attr name="required" />
        <!--必填标记文字 / 颜色-->
        <attr name="requiredText" />
        <attr name="requiredTextColor" />
        <!--系统相机拍照完成后是否写入姿态/GPS 等到 EXIF（失败则跳过，不影响回调）-->
        <attr name="writeCaptureExifMetadata" format="boolean"/>
        <!--是否调用uri的持久化权限takeUriPermission，默认为true-->
        <attr name="requireUriPermission" format="boolean" />
        <!--是否显示协议dialog-->
        <attr name="protocolDialog" format="boolean" />
        <!--媒体选择总数显示提示文字的大小-->
        <attr name="formCountLabelTextSize" format="dimension"/>
        <!--媒体选择总数显示提示文字颜色-->
        <attr name="countLabelTextColor" format="reference|color" />
        <!--是否显示媒体选择总数显示提示文字-->
        <attr name="showCountLabel" format="boolean" />
        <!--label文字大小-->
        <attr name="formLabelTextSize"/>
        <!--正文文字大小-->
        <attr name="formTextSize"/>
        <!--暂无数据占位布局的文字大小-->
        <attr name="emptyTextSize" format="dimension"/>
        <!--暂无数据占位布局的文字内容-->
        <attr name="emptyText" format="string"/>
        <!--FormFile中的限定文件格式，英文逗号分割-->
        <attr name="fileType" format="string"/>
        <!--input输入框，最大输入长度，默认不限制-->
        <attr name="maxLength"/>
        <!--*号文字大小-->
        <attr name="formRequiredSize"/>
        <!--是否展示底部边框-->
        <attr name="bottomBorder" />
        <!--底部边框高度-->
        <attr name="bottomBorderHeight" />
        <!--label文字颜色-->
        <attr name="labelTextColor" />
        <!--正文文字颜色-->
        <attr name="formTextColor" />
        <!--正文提示文字颜色-->
        <attr name="formHintTextColor" />
        <!--FormFile中列表中文字颜色-->
        <attr name="itemTextColor" />
        <!--正文默认的边距，防止跟边框重合-->
        <attr name="defaultTextMargin" />
        <!--底部边框颜色-->
        <attr name="borderBottomColor" />
        <!--底部边框左边margin-->
        <attr name="borderBottomStartMargin" />
        <!--底部边框右边margin-->
        <attr name="borderBottomEndMargin" />
        <!--输入框高度-->
        <attr name="inputHeight" />
        <!--多行文本输入框，内部padding-->
        <attr name="editAreaPadding" />
        <!--label文字左侧margin-->
        <attr name="labelStartMargin" />
        <!--label文字右侧margin-->
        <attr name="labelEndMargin" />
        <!--label文字顶部margin-->
        <attr name="labelTopMargin" />
        <!--label文字底部margin-->
        <attr name="labelBottomMargin" />
        <!--正文文字左侧margin-->
        <attr name="textStartMargin" />
        <!--正文文字右侧margin-->
        <attr name="textEndMargin" />
        <!--确认按钮文字颜色-->
        <attr name="confirmTextColor" />
        <!--DatePickDialog 右上角「今天/此刻」-->
        <attr name="todayTextColor" />
        <attr name="todayTextSize" />
        <!--DatePickDialog 左上角清空-->
        <attr name="clearTextColor" />
        <attr name="clearTextSize" />
        <attr name="clearText" />
        <!--DatePickDialog 取消按钮-->
        <attr name="negativeTextColor" />
        <attr name="negativeButtonTextSize" />
        <attr name="negativeText" />
        <!--DatePickDialog 标题与确定按钮-->
        <attr name="datePickTitle" />
        <attr name="datePickTitleTextColor" />
        <attr name="datePickTitleTextSize" />
        <attr name="datePickTitleMarginTop" />
        <attr name="calendarMonthTextColor" />
        <attr name="calendarMonthTextSize" />
        <attr name="positiveButtonTextSize" />
        <attr name="positiveText" />
        <!--DatePickDialog 单位标签与布局-->
        <attr name="unitLabelTextColor" />
        <attr name="unitLabelTextSize" />
        <attr name="buttonBarMarginTop" />
        <attr name="dialogPaddingHorizontal" />
        <attr name="dividerHeight" />
        <attr name="startMonth" />
        <attr name="endMonth" />
        <attr name="canOutSideDialog" />
        <attr name="showPositiveButton" />
        <attr name="showNegativeButton" />
        <attr name="datePickGravity" />
        <!--开始年份-->
        <attr name="startYear" />
        <!--结束年份-->
        <attr name="endYear" />
        <!--dialog背景-->
        <attr name="dialogBgDrawable"/>
        <!--input输入框背景-->
        <attr name="inputDrawable"/>
        <!-- FormEditText 是否显示清空图标；默认 true。有内容且获焦时显示，失焦隐藏 -->
        <attr name="showClearIcon" format="boolean"/>
        <!-- FormEditText 清空图标，默认 core-base icon_clear；定义见 ClearableEditText 同名 attr -->
        <attr name="clearIcon" />
        <!-- FormEditText 清空图标尺寸（0=intrinsic） -->
        <attr name="clearIconSize" />
        <!-- FormEditText 清空图标是否常驻；false=仅获焦显示，true=有内容即显示 -->
        <attr name="clearIconAlwaysShow" />
        <!-- FormEditText 清空图标与文字间距 -->
        <attr name="clearIconPadding" format="dimension"/>
        <!--日历选择样式-->
        <attr name="datePickModel" format="enum">
            <!--年月日-->
            <enum name="YEAR_MONTH_DAY" value="0" />
            <!--年月-->
            <enum name="YEAR_MONTH" value="1" />
            <!--年-->
            <enum name="YEAR" value="2" />
            <!--年月日时分秒-->
            <enum name="YEAR_MONTH_DAY_HOUR_MINUTE_SECOND" value="3" />
            <!--年月日时分-->
            <enum name="YEAR_MONTH_DAY_HOUR_MINUTE" value="4" />
            <!--年月日时-->
            <enum name="YEAR_MONTH_DAY_HOUR" value="5" />
            <!--时分秒-->
            <enum name="HOUR_MINUTE_SECOND" value="6" />
            <!--时分-->
            <enum name="HOUR_MINUTE" value="7" />
        </attr>
        <!--输入框失焦/提交时自动格式化，见 FormTextFormatter-->
        <attr name="formatText" format="enum">
            <enum name="normal" value="0" />
            <enum name="Integer" value="1" />
            <enum name="Double" value="2" />
            <enum name="Double_00" value="3" />
            <enum name="Float" value="4" />
            <enum name="Long" value="5" />
        </attr>
        <!--分隔符-->
        <attr name="separator" format="string" />
        <!--时间格式化的样式，例如：yyyy-MM-dd-->
        <attr name="format" format="string" />
        <!--开始时间格式化的样式，例如：yyyy-MM-dd-->
        <attr name="startFormat" format="string" />
        <!--截止时间格式化的样式，例如：yyyy-MM-dd-->
        <attr name="endFormat" format="string" />
        <!--提示文字-->
        <attr name="hint" format="string" />
        <!--显示行数-->
        <attr name="line" format="integer" />
        <!--小数点位数-->
        <attr name="digits" format="integer" />
        <!-- inputType / imeOptions 请直接写 android:inputType / android:imeOptions，由 FormEditText/FormEditArea 读取并应用到内部 EditText -->
        <!--圆点文字大小-->
        <attr name="textSize" />
        <!--日历宽度，不包括圆点-->
        <attr name="itemWidth"/>
        <!--日历高度，不包括圆点-->
        <attr name="itemHeight"/>
        <!--周末文字颜色-->
        <attr name="weekTextColor" />
        <!--工作日文字颜色-->
        <attr name="workingDayTextColor"/>
        <!--开始日期，日历开始的可选日期-->
        <attr name="selectableStartDate"/>
        <!--结束日期，日历结束的可选日期-->
        <attr name="selectableEndDate"/>
        <!--选中样式-->
        <attr name="selectedBg"/>
        <!--默认背景颜色-->
        <attr name="normalBg"/>
        <!--选中文字颜色-->
        <attr name="selectedTextColor"/>
        <!--日历网格横向间距-->
        <attr name="itemHorizontalSpacing"/>
        <!--日历网格纵向间距-->
        <attr name="itemVerticalSpacing"/>
        <!--日历网格未选中时间距颜色-->
        <attr name="itemGapColorUnselected"/>
        <!--日历网格选中时间距颜色-->
        <attr name="itemGapColorSelected"/>
        <!--底部标签与日期数字之间的间距-->
        <attr name="bottomTagMarginTop"/>
        <!--范围选择时起始日底部标签-->
        <attr name="rangeStartLabel"/>
        <!--范围选择时截止日底部标签-->
        <attr name="rangeEndLabel"/>
        <!--底部标签文字颜色-->
        <attr name="bottomTagTextColor"/>
        <!--底部标签文字大小-->
        <attr name="bottomTagTextSize"/>
        <!--底部标签文字大小 (sp)-->
        <attr name="bottomTagTextSizeSp"/>
        <!--是否显示弹窗左上角清空按钮，默认 true -->
        <attr name="showClearButton" format="boolean"/>
        <!--FormRadio 选项（逗号分隔名称，简单场景）；复杂数据请用 setRadioItems-->
        <attr name="radioOptions" format="string"/>
        <!--FormRadio 选项，每个 item 之间的间距-->
        <attr name="radioItemPadding" format="dimension"/>
        <!--FormRadio 单选图标尺寸-->
        <attr name="radioIconSize" format="dimension"/>
        <!--FormRadio 未选中边框粗细-->
        <attr name="radioStrokeWidth" format="dimension"/>
        <!--FormRadio 选中/未选中图标，未设置时使用 DrawableUtil 默认样式-->
        <attr name="radioCheckedDrawable" format="reference"/>
        <attr name="radioUncheckedDrawable" format="reference"/>
        <!--FormRadio 未选中边框色（选中图标色仍用 radioButtonTint）-->
        <attr name="radioUncheckedColor" format="color"/>
